# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g., mongodb+srv://username:password@cluster0.mongodb.net/pyq_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pyq_portal?retryWrites=true&w=majority
